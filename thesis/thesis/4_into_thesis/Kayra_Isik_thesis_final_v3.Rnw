  }
  for (i in seq_len(nrow(d))) {
    x <- d[i, ]
    s <- x$sunday_open_share
    # The column is a share in the source file and a percentage in the table.
    s <- if (is.na(s)) "--" else tt_num(if (s <= 1) s * 100 else s, 1)
    cat(sprintf("%s & %d & %s & %.0f & %s \\\\\n",
                x$.type, as.integer(x$Stores), s,
                x[["Mean open-day sales (EUR)"]],
                tt_num(x[["Weekly-predictable share"]], 2)))
  }
}
@
