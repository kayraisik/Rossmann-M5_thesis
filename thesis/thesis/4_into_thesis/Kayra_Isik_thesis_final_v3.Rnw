df_eda <- train_raw %>% filter(Open == 1, Sales > 0) %>%
  left_join(store_raw, by = "Store") %>%
  mutate(Month = month(Date, label = TRUE), MonthNum = month(Date),
         YearMonth = floor_date(Date, "month"),
