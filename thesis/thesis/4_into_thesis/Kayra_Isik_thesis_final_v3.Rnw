<<setup, include=FALSE, cache=FALSE>>=
# ------------------------------------------------------------------
# knitr setup. Heavy chunks are cached: the first knit is slow (the
# Section 4 grid re-runs 240 LightGBM fits), later knits are fast.
# Compile:  Rscript -e 'knitr::knit("Kayra_Isik_thesis_final.Rnw")'
# then pdflatex + bibtex + pdflatex x2 on the generated .tex.
# ------------------------------------------------------------------
knitr::opts_chunk$set(echo = FALSE, warning = FALSE, message = FALSE,
                      cache = TRUE, fig.align = "center")
suppressPackageStartupMessages({
  library(tidyverse); library(lubridate); library(zoo)
  library(rpart); library(ranger); library(xgboost); library(lightgbm)
})
# data location: same folder as the .Rnw first (server), then local fallbacks
data_dir <- "."
for (cand in c(".", "../code")) {
  if (file.exists(file.path(cand, "train.csv"))) { data_dir <- cand; break }
}
if (!file.exists(file.path(data_dir, "train.csv")))
  stop("train.csv and store.csv not found: put them in code/ or next to the .Rnw")
dir.create("eda_outputs", showWarnings = FALSE)
dir.create("rossmann_outputs", showWarnings = FALSE)
set.seed(42)

# ------------------------------------------------------------------
# Result tables.
#
# Every empirical table in this thesis is printed from a CSV written by the
# analysis script that computed it. No result is typed into this document.
# The CSVs live in thesis_tables/ and are produced by the .Rmd files; see
# README.md for which script writes which file.
#
# tr_read() reads one of them. If the file is missing, it returns NULL and the
# table prints a visible placeholder saying which script has not been run,
# so a missing result is obvious in the PDF rather than silent.
# ------------------------------------------------------------------
TT_DIR <- "../results"
# Stage 6 tables E1, E2, E6, E7: written from the executed Stage 6 report by
# rossmann_stage6_tables.R (no model fitting), so knitting the thesis is enough.
if (!all(file.exists(file.path(TT_DIR, paste0("stage6_e", c(1, 2, 6, 7), ".csv")))))
  source("rossmann_stage6_tables.R")
# Named tr_* throughout: several analysis chunks use short names such as tt,
# s1, s5 and lg for their own local objects, and a helper sharing one of those
# names would be silently overwritten before the tables are printed.
# The seeded Stage 2-4 rerun (9 Oct 2026) and its six-month diagnosis are kept
# in the project folder itself; these six files are read from there.
TT_NEW <- c("stage2_nstores.csv", "stage2_window.csv", "stage2_storetype.csv",
            "stage3_lags.csv", "stage4_rolling.csv", "stage2_window_diag.csv",
            "stage2_nstores_tests.csv")
tr_read <- function(file) {
  p <- file.path(TT_DIR, file)
  if (!file.exists(p)) stop("Required result file missing: ", p)
  suppressWarnings(readr::read_csv(p, show_col_types = FALSE))
}
# Placeholder row spanning `ncol` columns of a table whose CSV is absent.
tt_missing <- function(ncol, file, script) {
  cat(sprintf(
    "\\multicolumn{%d}{c}{\\emph{[%s not found --- run \\texttt{%s}]}} \\\\\n",
    ncol, gsub("_", "\\\\_", file), gsub("_", "\\\\_", script)))
}
# Fixed-decimal formatter that keeps trailing zeros (0.5 -> "0.5", not "0.5").
tt_num <- function(x, d = 1) formatC(as.numeric(x), format = "f", digits = d)
# Same, but with a typeset minus sign for negative values (tables).
tt_neg <- function(x, d = 1) sub("^-", "$-$", tt_num(x, d))
# Small whole numbers as words in running text ("five days"), larger as digits.
tt_words <- function(x) { x <- as.integer(x); w <- c("one","two","three","four","five","six","seven","eight","nine")
  ifelse(x >= 1 & x <= 9, w[pmax(1, pmin(9, x))], as.character(x)) }
# Signed percentage, as the Delta columns are printed in the text.
tt_signed <- function(x, d = 1) {
  v <- as.numeric(x)
  ifelse(is.na(v), "--",
         paste0(ifelse(v >= 0, "$+$", "$-$"), formatC(abs(v), format = "f", digits = d)))
}

# ------------------------------------------------------------------
# Numbers quoted in the running text.
#
# The tables above print themselves from the CSVs. The prose quotes many of
# the same numbers, and a figure quoted in a sentence can drift away from the
# table it refers to. The accessors below let the text pull from the same
# files, so a sentence and its table cannot disagree.
#
#   tr_rmse("XGBoost")        Stage 1 RMSE
#   tr_dow("XGBoost")         Stage 1 gain over Store-DOW, in per cent
#   tr_s5("1", "LightGBM")    Stage 5 RMSE for information set 1
#   tr_lag("XGBoost")         Stage 3 RMSE with lag features
# ------------------------------------------------------------------
.tr_s1   <- tr_read("stage1_pooled_models.csv")
.tr_stat <- tr_read("statistical_benchmarks.csv")
.tr_rf   <- tr_read("bagging_rf_configs.csv")
.tr_s5   <- tr_read("stage5_information_sets.csv")
.tr_s3   <- tr_read("stage3_lags.csv")

# Look one model up in Stage 1, falling back to the statistical benchmarks and
# then to the random-forest sweep, so the text does not have to know which
# script produced which row.
.tr_row <- function(model) {
  if (!is.null(.tr_s1)) { r <- .tr_s1[.tr_s1$Model == model, ]; if (nrow(r)) return(r) }
  if (!is.null(.tr_stat)) { r <- .tr_stat[.tr_stat$Model == model, ]; if (nrow(r)) return(r) }
  if (!is.null(.tr_rf) && model == "RandomForest") {
    r <- .tr_rf[grepl("p/3", .tr_rf$Model, fixed = TRUE), ]
    if (nrow(r)) return(data.frame(RMSE = r$RMSE[1], Delta_DOW = r$delta_dow[1]))
  }
  NULL
}
# "?" marks a missing number in the PDF instead of failing the build.
tr_rmse <- function(model) {
  r <- .tr_row(model); if (is.null(r)) "?" else sprintf("%.0f", r$RMSE[1])
}
# The Store-DOW baseline RMSE, used to express any model's gain on the same
# scale. Stage 1 reports it directly; the statistical-benchmark file carries
# its own copy under a slightly different label.
.tr_dow_ref <- local({
  v <- NA_real_
  if (!is.null(.tr_s1)) {
    r <- .tr_s1[.tr_s1$Model == "Store-DOW naive", ]
    if (nrow(r)) v <- r$RMSE[1]
  }
  if (is.na(v) && !is.null(.tr_stat)) {
    r <- .tr_stat[grepl("Store.DOW", .tr_stat$Model), ]
    if (nrow(r)) v <- r$RMSE[1]
  }
  v
})
tr_dow <- function(model) {
  r <- .tr_row(model)
  if (is.null(r)) return("?")
  # Stage 1 rows carry the gain already; the statistical benchmarks do not, so
  # it is computed from the shared Store-DOW reference.
  if ("Delta_DOW" %in% names(r) && !is.na(r$Delta_DOW[1]))
    return(sprintf("%.1f", r$Delta_DOW[1]))
  if (is.na(.tr_dow_ref)) return("?")
  sprintf("%.1f", (.tr_dow_ref - r$RMSE[1]) / .tr_dow_ref * 100)
}
tr_s5 <- function(step, model) {
  if (is.null(.tr_s5)) return("?")
  r <- .tr_s5[grepl(paste0("^", step), .tr_s5[[1]]) & .tr_s5$Model == model, ]
  if (!nrow(r)) "?" else sprintf("%.0f", r$RMSE[1])
}
tr_s5d <- function(step, model) {
  if (is.null(.tr_s5)) return("?")
  r <- .tr_s5[grepl(paste0("^", step), .tr_s5[[1]]) & .tr_s5$Model == model, ]
  if (!nrow(r)) "?" else sprintf("%.1f", abs(r$Delta_DOW[1]))
}
tr_lag <- function(model) {
  if (is.null(.tr_s3)) return("?")
  r <- .tr_s3[.tr_s3$Model == model, ]
  if (!nrow(r)) "?" else sprintf("%.0f", r$RMSE[1])
}
tr_lagd <- function(model) {
  if (is.null(.tr_s3)) return("?")
  r <- .tr_s3[.tr_s3$Model == model, ]
  if (!nrow(r)) "?" else sprintf("%.1f", r$Delta_DOW[1])
}

# The covariate-matched ARIMAX check. rossmann_arimax.Rmd, in the same folder
# as this file, is knitted before the thesis and writes the two arimax_*.csv
# files into thesis_tables/; these accessors only read them.
#   tr_arx("2015-05-08", "LightGBM")     RMSE of one model at one origin
#   tr_arx_ci("2015-05-08", "LightGBM")  what the paired interval shows
# The origin column is read as a Date, so it is compared as text.
tr_read_arx <- function(file) {
  if (!file.exists(file.path(TT_DIR, file)))
    stop(file, " not found in ", TT_DIR, "/. Knit rossmann_arimax.Rmd first.")
  tr_read(file)
}
tr_arx <- function(origin, model) {
  d <- tr_read_arx("arimax_comparison.csv")
  r <- d[as.character(d$Origin) == origin & d$Model == model, ]
  if (!nrow(r)) "?" else sprintf("%.0f", r$RMSE[1])
}
# Differences are comparator MSE minus ARIMAX MSE: an interval entirely above
# zero favours ARIMAX, entirely below zero favours the comparator.
tr_arx_ci <- function(origin, model) {
  d <- tr_read_arx("arimax_uncertainty.csv")
  r <- d[as.character(d$Origin) == origin &
         d$Comparison == paste(model, "minus ARIMAX"), ]
  if (!nrow(r)) return("?")
  if (r$Lower[1] > 0) "excludes zero in favour of ARIMAX"
  else if (r$Upper[1] < 0) paste("excludes zero in favour of", model)
  else "includes zero"
}
# Per cent RMSE reduction from Auto-ARIMA to ARIMAX at one origin: what the
# covariates alone add to the same statistical model.
tr_arx_gain <- function(origin) {
  a <- as.numeric(tr_arx(origin, "Auto-ARIMA")); x <- as.numeric(tr_arx(origin, "ARIMAX"))
  if (is.na(a) || is.na(x)) "?" else sprintf("%.0f", (a - x) / a * 100)
}
# Stores with a complete daily record from 1 January 2013 to the first origin,
# the eligibility rule of rossmann_arimax.Rmd, counted from train.csv.
tr_arx_eligible <- function() {
  if (!file.exists("train.csv")) return("?")
  d <- as.data.frame(data.table::fread("train.csv", select = c("Store", "Date")))
  d$Date <- as.Date(d$Date)
  d <- d[d$Date <= as.Date("2015-05-08"), ]
  full_len <- as.integer(as.Date("2015-05-08") - as.Date("2013-01-01")) + 1
  n_obs <- tapply(d$Date, d$Store, length)
  first <- as.Date(tapply(as.numeric(d$Date), d$Store, min), origin = "1970-01-01")
  as.character(sum(n_obs == full_len & first == as.Date("2013-01-01")))
}

# Training-history follow-up (rossmann_arimax_history.Rmd): the same design
# with 3-, 6- and 12-month windows plus the full history.
#   tr_hist_n("lgbm")    settings where LightGBM is significantly better
#   tr_hist_n("arimax")  settings where ARIMAX is significantly better
#   tr_hist_n("all")     number of origin-window settings
#   tr_hist_rmse("mean"|"min"|"max", model)  RMSE across the settings
.tr_words <- c("none", "one", "two", "three", "four", "five", "six", "seven", "eight")
#   tr_hist_n("lgbm", "2015-05-08")  the same, at one origin only
tr_hist_n <- function(which, origin = NULL) {
  ci <- tr_read_arx("arimax_history_ci.csv")
  if (!is.null(origin)) ci <- ci[as.character(ci$Origin) == origin, ]
  n <- switch(which, all = nrow(ci), lgbm = sum(ci$Upper < 0), arimax = sum(ci$Lower > 0))
  if (n < length(.tr_words)) .tr_words[n + 1] else as.character(n)
}
tr_hist_rmse <- function(stat, model) {
  h <- tr_read_arx("arimax_history.csv"); v <- h$RMSE[h$Model == model]
  if (!length(v)) "?" else sprintf("%.0f", match.fun(stat)(v))
}

# The hyperparameter grid, for the sentences that describe it. tr_grid_best()
# gives the lowest RMSE in the grid, tr_grid_worst() the highest, and
# tr_grid_n_beat() counts how many XGBoost settings beat the widest LightGBM
# configuration, so the claim in the text follows the table rather than a
# reading of it made at some earlier point.
.tr_grid <- tr_read("hyperparameter_grid.csv")
# The Setting column holds raw R argument names such as "max_depth = 8". The
# underscore would be read as a subscript, so it is rewritten for prose.
.tr_setting <- function(s) {
  s <- as.character(s)
  if (grepl("num_leaves", s)) paste(sub("^.*=\\s*", "", s), "leaves")
  else sub("=", "of", gsub("_", " ", s), fixed = TRUE)
}
tr_grid_best <- function(what = "RMSE") {
  if (is.null(.tr_grid)) return("?")
  r <- .tr_grid[which.min(.tr_grid$RMSE), ]
  if (what == "RMSE") sprintf("%.0f", r$RMSE[1]) else .tr_setting(r$Setting[1])
}
tr_grid_worst <- function() {
  if (is.null(.tr_grid)) return("?")
  sprintf("%.0f", .tr_grid$RMSE[which.max(.tr_grid$RMSE)])
}
tr_grid_n_beat <- function() {
  if (is.null(.tr_grid)) return("?")
  ref <- .tr_grid$RMSE[.tr_grid$Model == "LightGBM"]
  if (!length(ref)) return("?")
  n <- sum(.tr_grid$RMSE[.tr_grid$Model == "XGBoost"] < min(ref))
  c("none", "one", "two", "all three")[min(n + 1L, 4L)]
}
@


