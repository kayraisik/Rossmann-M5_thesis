d <- tr_read("store_types.csv")
sun_path <- file.path(TT_DIR, "tab_e8_store_types.csv")
sun <- if (file.exists(sun_path))
  suppressWarnings(readr::read_csv(sun_path, show_col_types = FALSE)) else NULL
if (is.null(d)) {
  tt_missing(5, "store_types.csv", "rossmann_eda.Rmd")
} else {
  d$.type <- toupper(substr(as.character(d$StoreType), 1, 1))
  if (!is.null(sun) && "sunday_open_share" %in% names(sun)) {
    sun$.type <- toupper(substr(as.character(sun$StoreTypeLabel), 1, 1))
