\IfFileExists{eda_outputs/fig_eda_sales_over_time.pdf}{\includegraphics[width=0.74\textwidth]{fig_eda_sales_over_time.pdf}}{\fbox{\parbox{0.92\textwidth}{\centering\vspace{1.5em}[fig\_eda\_sales\_over\_time]\vspace{1.5em}}}}
