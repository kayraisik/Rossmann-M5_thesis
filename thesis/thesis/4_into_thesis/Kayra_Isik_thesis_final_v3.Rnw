             bagging = sprintf("%.2f", kap_bag), rf = sprintf("%.2f", kap_rf),
             xgboost = "--", lightgbm = "--")
for (m in lad$model) {
  x <- lad[lad$model == m, ]
  cat(sprintf("%s & %.0f & %.0f & %.0f & %.0f & %s \\\\\n",
              row_lab[m], x$rmse, x$bias2, x$varc, x$esterr, kap_col[m]))
}
