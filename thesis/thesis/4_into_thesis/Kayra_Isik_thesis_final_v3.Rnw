    b <- lag   %>% filter(Model == k)
    if (nrow(a) != 1 || nrow(b) != 1) next
    cat(sprintf("%s & %.0f & %s & %.0f & %s & %s \\\\\n", nm[[k]],
                a$RMSE, tt_signed(if (k == "Store-mean naive") NA else a$Delta_rel),
                b$RMSE, tt_signed(if (k == "Store-mean naive") NA else b$Delta_rel),
                tt_signed(if (k %in% c("Store-mean naive", "Store-DOW naive")) NA else b$Delta_DOW)))
  }
}
